{
  "name": "keepsake-sdk",
  "version": "0.1.0",
  "description": "Keepsake ingestion client — record transactions (Source A) into the audit + reconciliation layer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "keywords": [
    "keepsake",
    "ledger",
    "double-entry",
    "audit",
    "reconciliation",
    "fintech",
    "ingestion"
  ],
  "author": "Steel Maxima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxima24/keepsake.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Maxima24/keepsake/tree/master/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Maxima24/keepsake/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
